#include<stdio.h>
int main()
{
	int income,age,existing_repayment;
	
	printf("Enter your age,income and existing loan repayment \n");
	scanf("%d %d %d",&age, &income, &existing_repayment);
		
	if(income <= 30000)
	{
		printf("Rejected due to income\n");
	}
	
	else if(age <21 || age >60)
	{
		printf("Rejected due to age \n");
	}
	
	else if(existing_repayment >(0.40 * income))
	{
		printf("Rejected due to existing loan repayment");
	}
	
	else{
		printf("Approved");
	}
	return 0;
}
